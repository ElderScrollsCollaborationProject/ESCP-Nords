<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Nord_BattleCry</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>battle fury</label>
        <description>The battle cry has taken hold. Movement has quickened, every blow is landing with more force than usual, and pain that would stop anyone else is being ignored.</description>
        <defaultLabelColor>(1.0, 0.45, 0.15)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>720~720</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>0.6</MoveSpeed>
                    <MeleeHitChance>0.15</MeleeHitChance>
                </statOffsets>
                <statFactors>
                    <MeleeDamageFactor>1.6</MeleeDamageFactor>
                    <IncomingDamageFactor>0.75</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

</Defs>
