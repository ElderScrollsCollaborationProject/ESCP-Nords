<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef MayRequire="Ludeon.RimWorld.Anomaly">
        <defName>ESCP_Hediff_Draugr</defName>
        <label>draugr</label>
        <description>An ancient Nord corpse, kept from rot by the old burial rites and woken to guard its tomb. It feels no pain, never tires and will not stop until it or the intruder is dead.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <duplicationAllowed>false</duplicationAllowed>
        <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
        <stages>
            <li>
                <naturalHealingFactor>0</naturalHealingFactor>
                <painFactor>0</painFactor>
                <statFactors>
                    <MeleeCooldownFactor>1.2</MeleeCooldownFactor>
                    <MoveSpeed>0.8</MoveSpeed>
                    <PsychicSensitivity>0</PsychicSensitivity>
                </statFactors>
                <statOffsets>
                    <ComfyTemperatureMin>-80</ComfyTemperatureMin>
                    <ComfyTemperatureMax>30</ComfyTemperatureMax>
                    <ToxicResistance>1</ToxicResistance>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Talking</capacity>
                        <postFactor>0</postFactor>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.85</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

</Defs>
